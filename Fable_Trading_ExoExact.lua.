local GiftRemote = GE:FindFirstChild("PetGiftingService")

local PetRegistry
pcall(function()
    PetRegistry = require(ReplicatedStorage.Data.PetRegistry)
end)

local State = {
    AutoAcceptRequest = false,
    AutoAcceptTrade = false,
    AutoConfirmTrade = false,
    AutoSendTicket = false,
    AutoUnfavorite = false,
    SkipLocked = true,
    GiftSystem = false,
    MinLevel = 0,
    MaxLevel = 100,
    MinWeight = 0,
    MaxWeight = math.huge,
}

local Stats = {
    Sent = 0,
    Requests = 0,
    Accepts = 0,
    Confirms = 0,
    Added = 0,
    Unfav = 0,
    Gifts = 0,
    Failed = 0,
}

local Running = true
local LastRequest = 0
local RequestCooldown = 4
local LastAction = "Ready"

local function getData()
    local ok2, data = pcall(function()
        return DataService:GetData()
    end)
    return ok2 and data or nil
end

local function getPets()
    local data = getData()
    return data and data.PetsData and data.PetsData.PetInventory and data.PetsData.PetInventory.Data or {}
end

local function getRarity(petType)
    local entry = PetRegistry and PetRegistry.PetList and PetRegistry.PetList[petType]
    return entry and (entry.Rarity or entry.RarityName) or nil
end

local function toSet(value)
    local out = {}
    if type(value) ~= "table" then return out end
    for k, v in pairs(value) do
        if v == true then
            out[k] = true
        elseif type(k) == "number" and v ~= nil then
            out[v] = true
        end
    end
    return out
end

local function selectedSets()
    return toSet(PetPicker.Value), toSet(MutationPicker.Value), toSet(RarityPicker.Value)
end

local function matches(uuid, pet)
    local pd = pet and pet.PetData
    if not pd then return false end

    local pets, muts, rarities = selectedSets()
    local level = tonumber(pd.Level) or 0
    local weight = tonumber(pd.BaseWeight) or 0
    local mutation = pd.MutationType
    local rarity = getRarity(pet.PetType)

    if level < State.MinLevel or level > State.MaxLevel then return false end
    if weight < State.MinWeight or weight > State.MaxWeight then return false end
    if next(pets) and not pets[pet.PetType] then return false end
    if next(muts) and not muts[mutation] then return false end
    if next(rarities) and not rarities[rarity] then return false end

    if State.SkipLocked and not State.AutoUnfavorite and pd.IsFavorite == true then
        return false
    end

    return true
end

local function targetPlayer()
    local p = Target.Value
    if typeof(p) == "Instance" and p:IsA("Player") and p ~= LocalPlayer then
        return p
    end
    return nil
end

local function findTicket()
    local function scan(container)
        if not container then return nil end
        for _, tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") and tool:GetAttribute(InvEnums.ITEM_TYPE) == ItemTypeEnums["Trading Ticket"] then
                return tool
            end
        end
    end
    return scan(LocalPlayer.Character) or scan(LocalPlayer.Backpack)
end

local function equipTicket(tool)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not tool or not hum then return false end
    if tool.Parent ~= char then
        local ok2 = pcall(function() hum:EquipTool(tool) end)
        if not ok2 then return false end
        task.wait(0.15)
    end
    return tool.Parent == char
end

local function findTool(uuid)
    local function scan(container)
        if not container then return nil end
        for _, tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") then
                local id = tool:GetAttribute(InvEnums.ITEM_UUID) or tool:GetAttribute("PET_UUID")
                if id == uuid then return tool end
            end
        end
    end
    return scan(LocalPlayer.Character) or scan(LocalPlayer.Backpack)
end

local function unfavorite(uuid)
    if not FavoriteRemote then return false end
    local tool = findTool(uuid)
    if not tool or tool:GetAttribute(InvEnums.Favorite) ~= true then return false end
    local ok2 = pcall(function() FavoriteRemote:FireServer(tool) end)
    if ok2 then Stats.Unfav += 1 return true end
    Stats.Failed += 1
    return false
end

local function tradeData()
    local rep = TradingController.CurrentTradeReplicator
    if not rep then return nil end
    local ok2, data = pcall(function() return rep:GetData() end)
    return ok2 and type(data) == "table" and data or nil
end

local function addMatchingPets()
    local trade = tradeData()
    if not trade then return end
    local myIndex = table.find(trade.players or {}, LocalPlayer)
    if not myIndex then return end
    local offer = trade.offers and trade.offers[myIndex]
    if not offer then return end

    local items = offer.items or {}
    local existing = {}
    for _, item in pairs(items) do
        if item and item.id then existing[item.id] = true end
    end

    local count = #items
    local limit = tonumber(TradeData.ItemLimit) or 12
    if count >= limit then return end

    for uuid, pet in pairs(getPets()) do
        if count >= limit then break end
        if not existing[uuid] and matches(uuid, pet) then
            if State.AutoUnfavorite and pet.PetData.IsFavorite == true then
                unfavorite(uuid)
                task.wait(0.12)
            end
            if getPets()[uuid] then
                local ok2 = pcall(function() AddItem:FireServer("Pet", uuid) end)
                if ok2 then
                    existing[uuid] = true
                    count += 1
                    Stats.Added += 1
                else
                    Stats.Failed += 1
                end
            end
        end
    end
end

