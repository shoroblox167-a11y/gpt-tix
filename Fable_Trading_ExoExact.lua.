-- =========================================================
-- REQUEST / TRADE AUTOMATION
-- =========================================================
RespondRequest.OnClientEvent:Connect(function(sender)
    if not Running or not State.AutoAcceptRequest then return end
    if typeof(sender) ~= "Instance" or not sender:IsA("Player") then return end
    local ok2 = pcall(function() RespondRequest:FireServer(sender, true) end)
    if ok2 then
        Stats.Requests += 1
        LastAction = "Accepted request from @" .. sender.Name
    else
        Stats.Failed += 1
    end
end)

task.spawn(function()
    while Running do
        pcall(function()
            State.MinLevel = tonumber(MinLevel.Value) or 0
            State.MaxLevel = tonumber(MaxLevel.Value) or 100
            State.MinWeight = math.max(0, tonumber(MinWeight.Value) or 0)
            State.MaxWeight = math.max(State.MinWeight, tonumber(MaxWeight.Value) or math.huge)
        end)

        local target = targetPlayer()
        local ticket = findTicket()
        local matchCount = 0
        for uuid, pet in pairs(getPets()) do
            if matches(uuid, pet) then matchCount += 1 end
        end

        pcall(function()
            StatusLabel:SetText(LastAction)
            TargetLabel:SetText("Target: " .. (target and ("@" .. target.Name) or "none"))
            TicketLabel:SetText("Ticket: " .. (ticket and "FOUND" or "not found"))
            MatchLabel:SetText("Matching pets: " .. tostring(matchCount))
            SentLabel:SetText("Sent: " .. Stats.Sent)
            ReqLabel:SetText("Requests: " .. Stats.Requests)
            AcceptLabel:SetText("Accepts: " .. Stats.Accepts)
            ConfirmLabel:SetText("Confirms: " .. Stats.Confirms)
            AddedLabel:SetText("Added: " .. Stats.Added)
            UnfavLabel:SetText("Unfav: " .. Stats.Unfav)
            GiftLabel:SetText("Gifts: " .. Stats.Gifts)
            FailedLabel:SetText("Failed: " .. Stats.Failed)
        end)

        if State.AutoSendTicket and target and not TradingController.CurrentTradeReplicator then
            if ticket then
                equipTicket(ticket)
            end
            if os.clock() - LastRequest >= RequestCooldown then
                LastRequest = os.clock()
                local ok2 = pcall(function() SendRequest:FireServer(target) end)
                if ok2 then
                    Stats.Sent += 1
                    LastAction = "Auto request sent"
                else
                    Stats.Failed += 1
                end
            end
        end

        local trade = tradeData()
        if trade then
            local myIndex = table.find(trade.players or {}, LocalPlayer)
            if myIndex then
                local otherIndex = myIndex == 1 and 2 or 1
                local myState = trade.states and trade.states[myIndex]
                local otherState = trade.states and trade.states[otherIndex]
                local elapsed = workspace:GetServerTimeNow() - (tonumber(trade.lastChange) or 0)
                local cooldown = tonumber(TradeData.ButtonCooldown) or 5

                if myState == "None" then
                    if State.AutoAcceptTrade and otherState ~= "None" and elapsed >= cooldown then
                        local ok2 = pcall(function() TradingController:Accept() end)
                        if ok2 then
                            Stats.Accepts += 1
                            LastAction = "Accepted trade"
                        else
                            Stats.Failed += 1
                        end
                    end
                    pcall(addMatchingPets)

                elseif myState == "Processing" then
                    LastAction = "Trade processing"

                elseif myState == "Accepted" then
                    if State.AutoConfirmTrade and elapsed >= cooldown then
                        local ok2 = pcall(function() TradingController:Confirm() end)
                        if ok2 then
                            Stats.Confirms += 1
                            LastAction = "Confirmed trade"
                        else
                            Stats.Failed += 1
                        end
                    end

                elseif myState == "Confirmed" then
                    LastAction = otherState == "Confirmed" and "Trade complete" or "Waiting for confirmation"
                end
            end
        end

        task.wait(0.15)
    end
end)

